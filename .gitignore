# data — regenerable, large, and never belongs in git
data/raw/
data/warehouse/
*.duckdb
*.duckdb.wal
synthea/
*.jar

# python
.venv/
__pycache__/
*.pyc

# node
node_modules/
.next/
.vercel/

# os / editor
.DS_Store
.idea/
.vscode/
# Secrets. This said `.envs` for a while, which matches nothing, so a real
# .env holding an API key sat untracked in a public repo one `git add -A`
# away from being published.
.env
.env.*
!.env.example

# next
web/out/
web/.next/

# web/public/data is generated by pipeline/export_web.py but IS committed:
# the Pages workflow runs `npm ci && npm run build` and never runs Python,
# so without these files the deployed site would have no data.

# pipeline run history — regenerated every run, machine-specific timings
data/run_log.json

# python packaging
src/*.egg-info/
build/
dist/
