# Copy to .env and fill in. .env is gitignored and must stay that way.

# A workspace-scoped key from the Anthropic Console starts sk-ant-api and
# needs nothing else. A user-scoped key starts sk-ant-usr, belongs to the
# organisation rather than a workspace, and additionally needs the id below.
ANTHROPIC_API_KEY=

# Only for a sk-ant-usr key. Found in the Console URL with the workspace open.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional override; defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5
