# Copy to .env.local for local builds. None of these are secrets: every
# NEXT_PUBLIC_ value is compiled into the public site.

# Sub-path when hosted under one (GitHub Pages project site:
# /clinical-care-gap-explorer). Leave empty on Vercel or at a domain root.
NEXT_PUBLIC_BASE_PATH=

# Public form endpoint for "Review this project", e.g. https://formspree.io/f/xxxxxxxx
# Empty: the review dialog says plainly that nothing was sent.
NEXT_PUBLIC_REVIEW_ENDPOINT=

# Production origin for share cards and canonical URLs, no trailing slash.
# Optional on Vercel, which provides its production URL at build time.
NEXT_PUBLIC_SITE_URL=
